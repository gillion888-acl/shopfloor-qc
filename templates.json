        {
          "id": "elec-2",
          "name": "输入电压",
          "type": "number",
          "unit": "V",
          "min": 4.9,
          "max": 5.1,
          "severity": "critical",
          "required": true,
          "frequency": "每批",
          "hint": "用稳压源给定值，偏离就是电源板问题。"
        },
        {
          "id": "elec-3",
          "name": "输出电压",
          "type": "number",
          "unit": "V",
          "min": 4.75,
          "max": 5.25,
          "severity": "critical",
          "required": true,
          "frequency": "每批",
          "hint": "万用表量输出端，带额定负载。"
        },
        {
          "id": "elec-4",
          "name": "螺丝扭力",
          "type": "number",
          "unit": "kgf·cm",
          "min": 8,
          "max": 10,
          "severity": "major",
          "required": true,
          "frequency": "首件",
          "hint": "扭力计复紧，看是否达到设定值。"
        },
        {
          "id": "elec-5",
          "name": "通电亮灯",
          "type": "bool",
          "expect": "yes",
          "severity": "critical",
          "required": true,
          "frequency": "每批",
          "hint": "插电 3 秒内指示灯亮；不亮整批不能出。"
        },
        {
          "id": "elec-6",
          "name": "焊接质量",
          "type": "option",
          "okOptions": ["良好"],
          "options": ["良好", "虚焊", "假焊", "脱焊"],
          "severity": "major",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "虚焊、假焊、脱焊都要挑出来返修。"
        },
        {
          "id": "elec-7",
          "name": "异响",
          "type": "bool",
          "expect": "no",
          "severity": "minor",
          "required": true,
          "frequency": "每批",
          "hint": "贴耳听 5 秒，有滋滋声选「是」。"
        },
        {
          "id": "elec-8",
          "name": "包装贴标",
          "type": "option",
          "okOptions": ["正确"],
          "options": ["正确", "错标", "漏贴"],
          "severity": "minor",
          "required": true,
          "frequency": "每批",
          "hint": "核对型号、批次号、客户标签。"
        },
        {
          "id": "elec-9",
          "name": "外观描述",
          "type": "text",
          "severity": "minor",
          "required": false,
          "frequency": "每批",
          "hint": "例如「上下壳段差 0.3 mm，客户可接受」。"
