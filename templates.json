{
  "app": "shopfloor-qc",
  "version": 1,
  "note": "内置示例检查项模板，由本项目自行编写，供五金冲压 / 塑胶射出 / 电子组装三类中小工厂直接改用。所有字段都可以在「模板」页改。",
  "templates": [
    {
      "id": "tpl-metal",
      "name": "五金冲压 · 首件与巡检",
      "industry": "五金 / 冲压",
      "builtin": true,
      "note": "适合 25–200 吨冲床、连续模或单工程模；首件确认 + 每 2 小时巡检。",
      "items": [
        {
          "id": "metal-1",
          "name": "料厚",
          "type": "number",
          "unit": "mm",
          "min": 0.95,
          "max": 1.05,
          "severity": "major",
          "required": true,
          "frequency": "每批",
          "hint": "用千分尺量板料原始厚度，避开压印区。"
        },
        {
          "id": "metal-2",
          "name": "外径",
          "type": "number",
          "unit": "mm",
          "min": 9.8,
          "max": 10.2,
          "severity": "critical",
          "required": true,
          "frequency": "首件",
          "hint": "关键装配尺寸，超一点就装不上壳体。"
        },
        {
          "id": "metal-3",
          "name": "孔径",
          "type": "number",
          "unit": "mm",
          "min": 4.95,
          "max": 5.05,
          "severity": "major",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "塞规通端过、止端不过视为合格。"
        },
        {
          "id": "metal-4",
          "name": "折弯角度",
          "type": "number",
          "unit": "°",
          "min": 89,
          "max": 91,
          "severity": "major",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "角度尺量两侧，换模后必测。"
        },
        {
          "id": "metal-5",
          "name": "毛刺高度",
          "type": "number",
          "unit": "mm",
          "max": 0.05,
          "severity": "minor",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "手摸割手感明显就超标，可去毛刺返工。"
        },
        {
          "id": "metal-6",
          "name": "冲压面划痕",
          "type": "bool",
          "expect": "no",
          "severity": "minor",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "迎光看，有明显划痕选「是」。"
        },
        {
          "id": "metal-7",
          "name": "表面处理",
          "type": "option",
          "okOptions": ["电镀", "喷涂", "本色"],
          "options": ["电镀", "喷涂", "本色"],
          "severity": "minor",
          "required": true,
          "frequency": "每批",
          "hint": "按工单要求选；与前一批不一致要问主管。"
        },
        {
          "id": "metal-8",
          "name": "外观描述",
          "type": "text",
          "severity": "minor",
          "required": false,
          "frequency": "每 2 小时",
          "hint": "看到什么写什么，例如「左下角轻微微碰伤 2 件」。"
        }
      ]
    },
    {
      "id": "tpl-plastic",
      "name": "塑胶射出 · 首件与过程巡检",
