        {
          "id": "plastic-4",
          "name": "缩水痕",
          "type": "bool",
          "expect": "no",
          "severity": "minor",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "厚胶位背面最容易看到凹痕。"
        },
        {
          "id": "plastic-5",
          "name": "飞边",
          "type": "bool",
          "expect": "no",
          "severity": "minor",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "分型面有薄薄一圈就是飞边。"
        },
        {
          "id": "plastic-6",
          "name": "熔接痕",
          "type": "option",
          "okOptions": ["无", "轻微"],
          "options": ["无", "轻微", "明显"],
          "severity": "minor",
          "required": true,
          "frequency": "每 2 小时",
          "hint": "「明显」要调模温或射速。"
        },
        {
          "id": "plastic-7",
          "name": "色差",
          "type": "option",
          "okOptions": ["OK"],
          "options": ["OK", "轻微", "明显"],
          "severity": "minor",
          "required": true,
          "frequency": "每批",
          "hint": "与封样件比对，别用记忆比。"
        },
        {
          "id": "plastic-8",
          "name": "外观描述",
          "type": "text",
          "severity": "minor",
          "required": false,
          "frequency": "每 2 小时",
          "hint": "例如「第 3 腔有轻微银纹」。"
        }
      ]
    },
    {
      "id": "tpl-electronics",
      "name": "电子组装 · 功能测试与外观",
      "industry": "电子 / 组装",
      "builtin": true,
      "note": "适合小家电、电源适配器、线束组装线；含通电功能项。",
      "items": [
        {
